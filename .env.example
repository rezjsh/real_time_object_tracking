# Copy this file to .env and fill in values as needed.

# COCO dataset download mirror (override if using a custom mirror)
COCO_DATASET_URL=http://images.cocodataset.org

# Weights & Biases (optional experiment tracking)
WANDB_API_KEY=
WANDB_PROJECT=object-tracking-app
WANDB_MODE=disabled

# Streamlit app
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# FastAPI deployment service
API_HOST=0.0.0.0
API_PORT=8000

# Device override: cpu | cuda | mps | auto
DEVICE=auto

# Logging
LOG_LEVEL=INFO
