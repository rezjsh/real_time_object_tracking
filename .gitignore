!data/processed/.gitkeep
!data/external/.gitkeep
!data/splits/.gitkeep

artifacts/metrics/*
artifacts/plots/*
artifacts/sample_outputs/*
artifacts/exported_models/*
!artifacts/metrics/.gitkeep
!artifacts/plots/.gitkeep
!artifacts/sample_outputs/.gitkeep
!artifacts/exported_models/.gitkeep

