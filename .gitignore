*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# uv
.uv/

# Data & artifacts (keep folder structure, ignore contents)
data/raw/*
data/processed/*
data/external/*
data/splits/*
